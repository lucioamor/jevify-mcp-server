{
  "name": "@nxlv-ai/jevify",
  "version": "0.3.0",
  "description": "Local, offline MCP server for jevify: find the AI calls in your code that are really decisions, then plan their migration to JEV in shadow mode.",
  "type": "module",
  "bin": {
    "jevify-mcp": "dist/server.js"
  },
  "files": [
    "dist/**/*.js",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "jevify",
    "jev",
    "ai-audit",
    "lovable",
    "claude-code"
  ],
  "author": "Lucio Amorim (Lovable Partner) <https://linkedin.com/in/lucioamorim>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/lucioamor/jevify-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/lucioamor/jevify-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucioamor/jevify-mcp-server.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
